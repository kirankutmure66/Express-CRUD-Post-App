<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
</head>
<body>
    <h2>Edit Your Post</h2>
    <p>post id : <%=post._id%></p>
    <p>post username : <%=post.username%></p>
    <form method="post" action="/posts/new/<%=post.id%>?_method=PATCH">
        <textarea rows="10" cols="30" name="content" id=""><%=post.content%></textarea>
        <br>
        <button>submit</button>
        <a href="/posts"><button>Cancel</button></a>
    </form>

</body>
</html>